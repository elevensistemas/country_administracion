<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="utf-8">
<title>Credenciales de Usuarios - Barrio La Ranita</title>
<style>
body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #333; line-height: 1.4; margin: 30px; }
h1 { color: #166534; font-size: 20pt; border-bottom: 2px solid #166534; padding-bottom: 6px; }
h2 { color: #15803d; font-size: 14pt; margin-top: 25px; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; }
p { margin-bottom: 10px; }
table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 25px; font-size: 10pt; }
th { background-color: #166534; color: #ffffff; text-align: left; padding: 8px 10px; border: 1px solid #166534; }
td { padding: 7px 10px; border: 1px solid #cbd5e1; }
tr:nth-child(even) { background-color: #f8fafc; }
.badge-admin { background-color: #e0f2fe; color: #0369a1; font-weight: bold; padding: 2px 6px; border-radius: 4px; }
.badge-owner { background-color: #dcfce7; color: #15803d; font-weight: bold; padding: 2px 6px; border-radius: 4px; }
.note-box { background-color: #f0fdf4; border-left: 4px solid #166534; padding: 12px; margin-bottom: 20px; font-size: 10.5pt; }
</style>
</head>
<body>

